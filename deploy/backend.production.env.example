APP_NAME="Student Internship Portal"
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=none
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Amazon RDS PostgreSQL
DATABASE_URL=postgresql+psycopg2://db_user:db_password@your-rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/internship_portal

# Frontend domains that may call the API.
# Examples:
# BACKEND_CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
BACKEND_CORS_ORIGINS=https://your-frontend-domain.com
BACKEND_CORS_ORIGIN_REGEX=

# Amazon S3 CV storage
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-cv-bucket-name
S3_PRESIGNED_URL_EXPIRE_SECONDS=300

# Prefer an IAM Role attached to EC2 in production.
# Leave these empty when the EC2 instance role has S3 permissions.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
